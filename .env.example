# Copy to .env and fill in. .env is gitignored.

# --- Database (matches docker-compose.yml) ---
# From your host machine:
DATABASE_URL="postgresql://support:support@localhost:5432/support_tech?schema=public"
# From inside the app container, use host `db` instead of `localhost`:
# DATABASE_URL="postgresql://support:support@db:5432/support_tech?schema=public"

# --- Auth (provider TBD - DECISIONS.md #1) ---
# Filled in during Phase 0 once the auth provider is chosen.

# --- Stripe (Phase 3) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend email (Phase 2) ---
RESEND_API_KEY=""
