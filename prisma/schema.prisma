// Phase 0: only what auth needs. Domain models (Skill, Booking, ...) arrive in later phases.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  seeker
  provider
  admin
}

enum UserStatus {
  pending
  approved
  suspended
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(seeker)
  status       UserStatus @default(pending)
  createdAt    DateTime   @default(now())
}
