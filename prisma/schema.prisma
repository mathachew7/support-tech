// Phase 1: Profiles & Skills. Phase 2: Booking & Scheduling. Payments arrive later.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  seeker
  provider
  admin
}

enum UserStatus {
  pending
  approved
  suspended
}

enum Proficiency {
  beginner
  intermediate
  advanced
  expert
}

enum DayOfWeek {
  sun
  mon
  tue
  wed
  thu
  fri
  sat
}

// Lifecycle: seeker creates a `requested` booking (no provider yet); an admin
// assigns a provider and confirms -> `scheduled`; then it terminates as
// completed / no_show / cancelled. (Extends the spec enum with `requested` to
// model the admin-assisted matching step - see DECISIONS.md.)
enum BookingStatus {
  requested
  scheduled
  completed
  no_show
  cancelled
}

// A seeker's session request: one skill, a commitment window, a timezone, and
// one or more preferred times an admin can pick from to create Bookings.
enum RequestStatus {
  requested // submitted, awaiting admin match
  matched // admin has scheduled at least one session from it
  cancelled
  closed
}

// Admin-issued invoices shown to seekers. Stripe processing links in later.
enum InvoiceStatus {
  pending // issued, awaiting payment
  paid
  void // cancelled by admin, no longer owed
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(seeker)
  status       UserStatus @default(pending)
  // Profile fields (optional; providers fill these in, seekers may too)
  headline     String? // short tagline, e.g. "Senior SRE - Kubernetes & AWS"
  bio          String?    @db.Text
  location     String?
  avatarUrl    String? // optional profile photo URL (upload comes later)
  company      String? // current company
  position     String? // current job title / role
  linkedin     String? // LinkedIn profile URL
  github       String? // GitHub profile URL
  website      String? // personal site / portfolio URL
  skills       String[]   @default([]) // seeker: skills/interests; free-form
  // Billing address (used on invoices)
  street       String?
  city         String?
  state        String?
  zip          String?
  country      String?
  createdAt    DateTime   @default(now())

  providerSkills ProviderSkill[]
  availability   Availability[]
  // Bookings this user is the seeker on / the assigned provider on.
  seekerBookings   Booking[] @relation("SeekerBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  sessionRequests  SessionRequest[]
  invoices         Invoice[]

  @@index([role, status])
}

// Canonical skill catalog. Seeded, admin-curated. Providers attach to these.
model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  category  String
  createdAt DateTime @default(now())

  providers ProviderSkill[]
  bookings  Booking[]
  requests  SessionRequest[]

  @@index([category])
}

// A skill a provider offers, at a stated proficiency. Join with extra data.
model ProviderSkill {
  id          String      @id @default(cuid())
  provider    User        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId     String
  proficiency Proficiency @default(intermediate)

  @@unique([providerId, skillId])
  @@index([skillId])
}

// A provider's recurring weekly availability window, stored as minutes-from-midnight.
model Availability {
  id         String    @id @default(cuid())
  provider   User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  day        DayOfWeek
  startMin   Int // 0..1439, minutes from midnight (e.g. 540 = 09:00)
  endMin     Int // must be > startMin

  @@index([providerId])
}

// A seeker's session request, and (once an admin assigns) the scheduled session.
model Booking {
  id          String        @id @default(cuid())
  seeker      User          @relation("SeekerBookings", fields: [seekerId], references: [id], onDelete: Cascade)
  seekerId    String
  // Null until an admin assigns a provider; SetNull so removing a provider
  // account leaves the request intact for reassignment.
  provider    User?         @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: SetNull)
  providerId  String?
  skill       Skill         @relation(fields: [skillId], references: [id])
  skillId     String
  datetime    DateTime // absolute start time of the requested session
  durationMin Int           @default(60)
  note        String?       @db.Text
  status      BookingStatus @default(requested)
  createdAt   DateTime      @default(now())

  @@index([seekerId])
  @@index([providerId])
  @@index([status])
}

// The seeker's request. A future subscription/payment will link to this by id.
model SessionRequest {
  id       String @id @default(cuid())
  // Human-friendly reference shown to users (e.g. "REQ-7F3K2M"). Nullable only
  // so the migration can add it to existing rows; new rows always get one.
  reference String? @unique
  seeker   User    @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  seekerId String
  // Linked to the catalog when the typed skill matches; free-typed otherwise.
  skill            Skill?               @relation(fields: [skillId], references: [id])
  skillId          String?
  skillName        String // display name (canonical catalog name or title-cased free text)
  commitmentMonths Int // 1, 3, or 5
  startDate        DateTime
  endDate          DateTime // startDate + commitmentMonths (precomputed)
  timezone         String // IANA tz, e.g. "America/New_York"
  note             String?              @db.Text
  status           RequestStatus        @default(requested)
  createdAt        DateTime             @default(now())
  times            SessionRequestTime[]
  invoices         Invoice[]

  @@index([seekerId])
  @@index([status])
}

// A single preferred time on a request. Admin picks one (or more) to schedule.
model SessionRequestTime {
  id        String         @id @default(cuid())
  request   SessionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  datetime  DateTime

  @@index([requestId])
}

// An admin-issued invoice a seeker can view and (later) pay. Money is stored in
// integer cents to avoid float rounding.
model Invoice {
  id          String         @id @default(cuid())
  number      String         @unique // "INV-00001"
  seeker      User           @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  seekerId    String
  // Optional link to what the invoice is for.
  request     SessionRequest? @relation(fields: [requestId], references: [id])
  requestId   String?
  amountCents Int
  currency    String         @default("USD")
  description String?
  // Plan/installment context so the invoice reads like a real one.
  planName    String? // e.g. "3-month mentorship"
  periodLabel String? // e.g. "August 2026"
  periodIndex Int? // which installment, e.g. 2
  periodTotal Int? // of how many, e.g. 3
  status      InvoiceStatus  @default(pending)
  issuedAt    DateTime       @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([seekerId])
  @@index([status])
}
